APP_PORT=3001
# PostgreSQL ja existente. Use sslmode=require quando o servidor exigir TLS.
NUXT_DATABASE_URL=postgres://usuario_app:senha@seu-servidor:5432/calcados?sslmode=require
# Conecta a um banco existente (normalmente postgres) com uma role que possua CREATEDB.
NUXT_DATABASE_ADMIN_URL=postgres://usuario_admin:senha@seu-servidor:5432/postgres?sslmode=require
JWT_ACCESS_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=gere-outra-chave-aleatoria-com-pelo-menos-32-caracteres
ADMIN_INITIAL_PASSWORD=defina-uma-senha-inicial-forte
COOKIE_SECURE=
